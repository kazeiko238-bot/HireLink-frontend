{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hirelink-backend-qnww.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
